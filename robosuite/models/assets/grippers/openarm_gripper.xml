<mujoco model="openarm_gripper">
    <asset>
        <mesh name="hand_collision" file="meshes/openarm_gripper/hand.stl" scale="0.001 0.001 0.001" />
        <mesh name="finger_collision" file="meshes/openarm_gripper/finger.stl" scale="0.001 0.001 0.001" />
        <mesh name="finger_collision_left" file="meshes/openarm_gripper/finger.stl" scale="0.001 -0.001 0.001" />

        <mesh name="hand_0.obj" file="meshes/openarm_gripper/hand_0.obj" scale="0.001 0.001 0.001" />
        <mesh name="hand_1.obj" file="meshes/openarm_gripper/hand_1.obj" scale="0.001 0.001 0.001" />
        <mesh name="finger_0.obj" file="meshes/openarm_gripper/finger_0.obj" scale="0.001 0.001 0.001" />
        <mesh name="finger_0_flip.obj" file="meshes/openarm_gripper/finger_0.obj" scale="0.001 -0.001 0.001" />
        <mesh name="finger_1.obj" file="meshes/openarm_gripper/finger_1.obj" scale="0.001 0.001 0.001" />
        <mesh name="finger_1_flip.obj" file="meshes/openarm_gripper/finger_1.obj" scale="0.001 -0.001 0.001" />

        <material name="matte_black" rgba="0.24705882 0.24705882 0.24705882 1.0" reflectance="0.05098039000000001" shininess="0.5" />
        <material name="metal_silver" rgba="0.79607843 0.79607843 0.79607843 1.0" reflectance="1.0" shininess="1.0" />
        <material name="default_material" rgba="0.7 0.7 0.7 1" />
        <material name="collision_material" rgba="1.0 0.28 0.1 0.9" />
    </asset>

    <default>
        <default class="motor_finger">
            <joint limited="true" type="slide" damping="2" stiffness="0.5" />
            <position forcelimited="true" forcerange="-333 333" ctrllimited="true" ctrlrange="0 0.044" kp="100" />
        </default>
        <default class="collision">
             <geom material="collision_material" condim="3" conaffinity="1" priority="1" group="3" solref="0.005 1" friction="1 0.01 0.01" />
             <equality solimp="0.99 0.999 1e-05" solref="0.005 1" />
        </default>
         <default class="visual">
            <geom contype="0" conaffinity="0" group="2" />
        </default>
    </default>

    <actuator>
        <position name="finger_joint1_ctrl" joint="finger_joint1" class="motor_finger" />
        <position name="finger_joint2_ctrl" joint="finger_joint2" class="motor_finger" />
    </actuator>

    <worldbody>
        <body name="gripper_base" pos="0 0 0" quat="1 0 0 0">
             <site name="ft_frame" pos="0 0 0" size="0.01 0.01 0.01" rgba="1 0 0 1" type="sphere" group="1"/>
             <inertial pos="0.0 0.002 0.01" quat="1.0 0.0 0.0 0.0" mass="0.15" diaginertia="0.0001 0.00025 0.00017" />
             <!-- Collision geoms -->
             <geom name="hand_collision" pos="0.0 0.005 -0.6585" quat="1.0 0.0 0.0 0.0" type="mesh" mesh="hand_collision" class="collision" />
             <!-- Visual geoms -->
             <geom name="hand_visual_0" pos="0.0 0.005 -0.6585" quat="1.0 0.0 0.0 0.0" material="metal_silver" type="mesh" mesh="hand_0.obj" class="visual" />
             <geom name="hand_visual_1" pos="0.0 0.005 -0.6585" quat="1.0 0.0 0.0 0.0" material="metal_silver" type="mesh" mesh="hand_1.obj" class="visual" />
             
             <!-- EEF Site for reference -->
             <body name="eef" pos="0 -0.0 0.08" quat="1.0 0.0 0.0 0.0">
                <site name="grip_site" pos="0 0 0" size="0.01 0.01 0.01" rgba="1 0 0 0.5" type="sphere" group="1"/>
                <site name="ee_x" pos="0.1 0 0" size="0.005 .1"  quat="0.707105  0 0.707108 0 " rgba="1 0 0 0" type="cylinder" group="1"/>
                <site name="ee_y" pos="0 0.1 0" size="0.005 .1" quat="0.707105 0.707108 0 0" rgba="0 1 0 0" type="cylinder" group="1"/>
                <site name="ee_z" pos="0 0 0.1" size="0.005 .1" quat="1 0 0 0" rgba="0 0 1 0" type="cylinder" group="1"/>
                <site name="grip_site_cylinder" pos="0 0 0" size="0.005 10" rgba="0 1 0 0.3" type="cylinder" group="1"/>
             </body>

             <body name="right_finger" pos="0 0.00 0.015" quat="1.0 0.0 0.0 0.0">
                 <joint name="finger_joint1" type="slide" ref="0.0" class="motor_finger" range="0.0 0.044" axis="0 -1 0" />
                 <inertial pos="0.0064528 -0.01702 0.0219685" quat="1.0 0.0 0.0 0.0" mass="0.03602545343277134" diaginertia="2.3749999999999997e-06 2.3749999999999997e-06 7.5e-07" />
                 <geom name="right_finger_collision" pos="0.0 0.05 -0.673001" quat="1.0 0.0 0.0 0.0" type="mesh" mesh="finger_collision_left" class="collision" />
                 <geom name="right_finger_visual_0" pos="0.0 0.05 -0.673001" quat="1.0 0.0 0.0 0.0" material="default_material" type="mesh" mesh="finger_0_flip.obj" class="visual" />
                 <geom name="right_finger_visual_1" pos="0.0 0.05 -0.673001" quat="1.0 0.0 0.0 0.0" material="matte_black" type="mesh" mesh="finger_1_flip.obj" class="visual" />
             </body>

             <body name="left_finger" pos="0 0.012 0.015" quat="1.0 0.0 0.0 0.0">
                 <joint name="finger_joint2" type="slide" ref="0.0" class="motor_finger" range="0.0 0.044" axis="0 1 0" />
                 <inertial pos="0.0064528 0.01702 0.0219685" quat="1.0 0.0 0.0 0.0" mass="0.03602545343277134" diaginertia="2.3749999999999997e-06 2.3749999999999997e-06 7.5e-07" />
                 <geom name="left_finger_collision" pos="0.0 -0.05 -0.673001" quat="1.0 0.0 0.0 0.0" type="mesh" mesh="finger_collision" class="collision" />
                 <geom name="left_finger_visual_0" pos="0.0 -0.05 -0.673001" quat="1.0 0.0 0.0 0.0" material="default_material" type="mesh" mesh="finger_0.obj" class="visual" />
                 <geom name="left_finger_visual_1" pos="0.0 -0.05 -0.673001" quat="1.0 0.0 0.0 0.0" material="matte_black" type="mesh" mesh="finger_1.obj" class="visual" />
             </body>
        </body>
    </worldbody>
    <sensor>
        <force name="force_ee" site="ft_frame"/>
        <torque name="torque_ee" site="ft_frame"/>
    </sensor>
    <contact>
        <exclude body1="gripper_base" body2="right_finger" />
        <exclude body1="gripper_base" body2="left_finger" />
    </contact>
     <tendon>
        <fixed name="split">
            <joint joint="finger_joint1" coef="0.5" />
            <joint joint="finger_joint2" coef="0.5" />
        </fixed>
    </tendon>
      <equality>
        <joint joint1="finger_joint1" joint2="finger_joint2" solimp="0.95 0.99 0.001" solref="0.005 1" />
      </equality>
</mujoco>
